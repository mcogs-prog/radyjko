<Window x:Class="RADYJKO.MicroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RADYJKO Micro" Height="140" Width="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" MouseDown="Window_MouseDown" MouseDoubleClick="Window_MouseDoubleClick">
    <Border CornerRadius="70" Background="#CC111116" BorderBrush="#38BDF8" BorderThickness="2" ClipToBounds="True">
        <Grid>
            <Image x:Name="ImgCoverArt" Stretch="UniformToFill" Opacity="0.55"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                <TextBlock x:Name="TxtStation" Text="RADYJKO" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtTrack" Text="PRO" FontSize="9" Foreground="#E2E8F0" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
