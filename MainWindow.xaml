<Window x:Class="RADYJKO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RADYJKO 3.3.0 • OGŚ" Height="780" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D10" Foreground="#FAFAFA"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2D2D36"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#16161B"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#2A2A33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📻 RADYJKO" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                <Border Background="#3B82F6" CornerRadius="4" Padding="4,1" Margin="8,4,0,0">
                    <TextBlock Text="3.3 MULTI+DE" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Border>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Highlighted Language Selector Pill -->
                <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="6" Padding="4,2" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐" FontSize="12" VerticalAlignment="Center" Margin="2,0,4,0"/>
                        <ComboBox x:Name="ComboLang" Width="65" Height="24" SelectionChanged="ComboLang_SelectionChanged" Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" BorderThickness="0">
                            <ComboBoxItem Content="🇵🇱 PL"/>
                            <ComboBoxItem Content="🇬🇧 EN"/>
                            <ComboBoxItem Content="🇱🇹 LT"/>
                            <ComboBoxItem Content="🇩🇪 DE"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Button x:Name="BtnMicroPlayer" Content="🔴 Micro" Padding="8,4" FontSize="11" Margin="0,0,6,0" Background="#9F1239" Foreground="White" FontWeight="Bold" Click="BtnMicroPlayer_Click"/>
                <Button x:Name="BtnMiniPlayer" Content="🗗 Mini" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnMiniPlayer_Click"/>
                <TextBlock x:Name="TxtSleepStatus" Text="" FontSize="11" Foreground="#F59E0B" Margin="0,4,8,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#CC141418" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="88" Height="88" CornerRadius="8" Background="#1C1C22" ClipToBounds="True" Margin="0,0,14,0">
                    <Grid>
                        <TextBlock Text="🎵" FontSize="34" Foreground="#3F3F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="ImgCoverArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock x:Name="TxtCurrentStation" Text="Wybierz stację..." FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                        <TextBlock x:Name="TxtStatus" Text="Gotowy" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DockPanel Margin="0,4,0,6">
                        <Button x:Name="BtnSpotify" Content="💚 Spotify" Width="70" Height="22" FontSize="10" Background="#1DB954" Foreground="#09090B" FontWeight="Bold" DockPanel.Dock="Right" Click="BtnSpotify_Click"/>
                        <TextBlock x:Name="TxtTrackInfo" Text="Brak aktywnego utworu" FontSize="12" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                    </DockPanel>

                    <UniformGrid Columns="8" Height="20" VerticalAlignment="Bottom">
                        <ProgressBar x:Name="Bar0" Orientation="Vertical" Minimum="0" Maximum="1" Value="0.05" Foreground="#38BDF8" Background="#1D1D24" BorderThickness="0" Margin="2,0"/>
                        <ProgressBar x:Name="Bar1" Orientation="Vertical" Minimum="0" Maximum="1" Value="0.05" Foreground="#38BDF8" Background="#1D1D24" BorderThickness="0" Margin="2,0"/>
                        <ProgressBar x:Name="Bar2" Orientation="Vertical" Minimum="0" Maximum="1" Value="0.05" Foreground="#38BDF8" Background="#1D1D24" BorderThickness="0" Margin="2,0"/>
                        <ProgressBar x:Name="Bar3" Orientation="Vertical" Minimum="0" Maximum="1" Value="0.05" Foreground="#38BDF8" Background="#1D1D24" BorderThickness="0" Margin="2,0"/>
                        <ProgressBar x:Name="Bar4" Orientation="Vertical" Minimum="0" Maximum="1" Value="0.05" Foreground="#38BDF8" Background="#1D1D24" BorderThickness="0" Margin="2,0"/>
                        <ProgressBar x:Name="Bar5" Orientation="Vertical" Minimum="0" Maximum="1" Value="0.05" Foreground="#38BDF8" Background="#1D1D24" BorderThickness="0" Margin="2,0"/>
                        <ProgressBar x:Name="Bar6" Orientation="Vertical" Minimum="0" Maximum="1" Value="0.05" Foreground="#38BDF8" Background="#1D1D24" BorderThickness="0" Margin="2,0"/>
                        <ProgressBar x:Name="Bar7" Orientation="Vertical" Minimum="0" Maximum="1" Value="0.05" Foreground="#38BDF8" Background="#1D1D24" BorderThickness="0" Margin="2,0"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnTogglePlay" Content="▶ Odtwarzaj" Width="105" Height="34" 
                    Background="#38BDF8" Foreground="#09090B" FontWeight="Bold" Margin="0,0,8,0"
                    Click="BtnTogglePlay_Click"/>

            <Button x:Name="BtnRecord" Grid.Column="1" Content="⏺ REC" Width="70" Height="34" 
                    Background="#1E1E24" Foreground="#EF4444" FontWeight="Bold" Margin="0,0,8,0"
                    Click="BtnRecord_Click"/>

            <Slider x:Name="SliderVolume" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0.75" 
                    ValueChanged="SliderVolume_ValueChanged" Margin="6,0"/>

            <TextBlock Grid.Column="3" x:Name="TxtVolume" Text="75%" VerticalAlignment="Center" FontSize="11" Foreground="#A1A1AA" Width="32" TextAlignment="Right"/>
        </Grid>

        <TabControl x:Name="MainTabControl" Grid.Row="3" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#A1A1AA"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="7,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="#CC16161B" CornerRadius="6,6,0,0" Margin="0,0,2,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#CC22222A"/>
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem x:Name="TabStationsHeader" Header="★ Stacje">
                <Border Background="#CC121216" CornerRadius="0,6,6,6" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Border Grid.Row="0" Background="#191920" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock x:Name="LblAddCustom" Text="Dodaj własną stację (URL / M3U / PLS)" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCustomName" Text="Nazwa stacji..." Foreground="#A1A1AA" Margin="0,0,4,0" GotFocus="TxtCustom_GotFocus"/>
                                    <TextBox x:Name="TxtCustomUrl" Grid.Column="1" Text="Adres strumienia (http://...)" Foreground="#A1A1AA" GotFocus="TxtCustom_GotFocus"/>
                                </Grid>
                                <Button x:Name="BtnAddCustom" Content="➕ Dodaj do listy" Height="26" Background="#38BDF8" Foreground="#09090B" FontWeight="Bold" Click="BtnAddCustomStation_Click"/>
                            </StackPanel>
                        </Border>
                        
                        <ListBox Grid.Row="1" x:Name="ListFavorites" Background="Transparent" BorderThickness="0" SelectionChanged="ListFavorites_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Background="#191920" CornerRadius="6" Margin="0,0,0,3">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="#FAFAFA" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Genre}" Foreground="#71717A" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <Button x:Name="BtnDelFav" Grid.Row="2" Content="Usuń wybraną stację z listy" Height="24" Margin="0,4,0,0" Background="#191920" Foreground="#EF4444" FontSize="11" Click="BtnDeleteFavorite_Click"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem x:Name="TabSearchHeader" Header="🔍 Szukaj">
                <Border Background="#CC121216" CornerRadius="0,6,6,6" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSearchQuery" KeyDown="TxtSearchQuery_KeyDown"/>
                            <Button x:Name="BtnSearchAction" Grid.Column="1" Content="Szukaj" Width="65" Height="28" Margin="6,0,0,0" Click="BtnSearch_Click"/>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="ListSearchResults" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Background="#191920" CornerRadius="6" Margin="0,0,0,3">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="#FAFAFA" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Genre}" Foreground="#71717A" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnPlaySearched" Content="▶ Odtwarzaj" Height="28" Margin="0,0,3,0" Click="BtnPlaySearched_Click"/>
                            <Button x:Name="BtnAddSearched" Grid.Column="1" Content="★ Do ulubionych" Height="28" Margin="3,0,0,0" Background="#38BDF8" Foreground="#09090B" FontWeight="SemiBold" Click="BtnAddSearchedToFavorites_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 12-BAND EQ -->
            <TabItem x:Name="TabEqHeader" Header="🎚 EQ">
                <Border Background="#CC121216" CornerRadius="0,6,6,6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock x:Name="LblEqTitle" Text="12-pasmowy korektor graficzny" FontWeight="Bold" FontSize="13"/>
                            <CheckBox x:Name="ChkAutoLeveler" Content="Auto-Leveler" Foreground="#10B981" FontSize="11" HorizontalAlignment="Right" Checked="ChkAutoLeveler_Changed" Unchecked="ChkAutoLeveler_Changed" IsChecked="True"/>
                        </DockPanel>
                        <UniformGrid Grid.Row="1" Columns="12" Margin="0,0,0,8">
                            <StackPanel HorizontalAlignment="Center"><Slider x:Name="SliderEq0" Orientation="Vertical" Height="140" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_ValueChanged"/><TextBlock Text="31" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel HorizontalAlignment="Center"><Slider x:Name="SliderEq1" Orientation="Vertical" Height="140" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_ValueChanged"/><TextBlock Text="63" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel HorizontalAlignment="Center"><Slider x:Name="SliderEq2" Orientation="Vertical" Height="140" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_ValueChanged"/><TextBlock Text="125" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel HorizontalAlignment="Center"><Slider x:Name="SliderEq3" Orientation="Vertical" Height="140" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_ValueChanged"/><TextBlock Text="250" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel HorizontalAlignment="Center"><Slider x:Name="SliderEq4" Orientation="Vertical" Height="140" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_ValueChanged"/><TextBlock Text="500" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel HorizontalAlignment="Center"><Slider x:Name="SliderEq5" Orientation="Vertical" Height="140" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_ValueChanged"/><TextBlock Text="1k" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel HorizontalAlignment="Center"><Slider x:Name="SliderEq6" Orientation="Vertical" Height="140" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_ValueChanged"/><TextBlock Text="2k" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel HorizontalAlignment="Center"><Slider x:Name="SliderEq7" Orientation="Vertical" Height="140" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_ValueChanged"/><TextBlock Text="4k" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel HorizontalAlignment="Center"><Slider x:Name="SliderEq8" Orientation="Vertical" Height="140" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_ValueChanged"/><TextBlock Text="8k" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel HorizontalAlignment="Center"><Slider x:Name="SliderEq9" Orientation="Vertical" Height="140" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_ValueChanged"/><TextBlock Text="12k" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel HorizontalAlignment="Center"><Slider x:Name="SliderEq10" Orientation="Vertical" Height="140" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_ValueChanged"/><TextBlock Text="14k" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel HorizontalAlignment="Center"><Slider x:Name="SliderEq11" Orientation="Vertical" Height="140" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqSlider_ValueChanged"/><TextBlock Text="16k" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center"/></StackPanel>
                        </UniformGrid>
                        <DockPanel Grid.Row="2">
                            <Button x:Name="BtnResetEq" Content="Reset" Width="90" Height="26" Click="PresetFlat_Click"/>
                            <Button x:Name="BtnElecEq" Content="Electronic" Width="90" Height="26" Margin="6,0" Click="PresetElectronic_Click" HorizontalAlignment="Left"/>
                            <Button x:Name="BtnVocalEq" Content="Vocal" Width="90" Height="26" Click="PresetVocal_Click" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem x:Name="TabRemoteHeader" Header="📱 Pilot">
                <Border Background="#CC121216" CornerRadius="0,6,6,6" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="LblRemoteHeader" Text="Sterowanie z telefonu (Web Remote)" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LblRemoteDesc" Text="Otwórz poniższy adres w przeglądarce smartfona w tej samej sieci Wi-Fi:" FontSize="11" Foreground="#71717A" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Border Background="#181820" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Adres pilota:" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtRemoteUrl" Text="http://192.168.1.X:8080" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <DockPanel>
                            <Button x:Name="BtnCopyRemote" Content="📋 Kopiuj adres" Height="28" Width="120" Click="BtnCopyRemoteUrl_Click"/>
                            <Button x:Name="BtnOpenRemote" Content="🌐 Otwórz w przeglądarce" Height="28" Width="160" HorizontalAlignment="Right" Click="BtnOpenBrowserRemote_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="TabPlannerHeader" Header="📅 Planer">
                <Border Background="#CC121216" CornerRadius="0,6,6,6" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LblPlannerTitle" Grid.Row="0" Text="Zaplanowane nagrania audycji do MP3" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ListBox Grid.Row="1" x:Name="ListSchedules" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Background="#191920" CornerRadius="6" Margin="0,0,0,4">
                                        <DockPanel>
                                            <TextBlock Text="{Binding StationName}" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                            <TextBlock Text="{Binding StartTime, StringFormat=' ({0:hh\\:mm})'}" Foreground="#A1A1AA"/>
                                            <TextBlock Text="{Binding DurationMinutes, StringFormat=' - {0} min'}" Foreground="#71717A"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="BtnAddSchedule" Grid.Row="2" Content="➕ Zaplanuj nagranie bieżącej stacji na 60 min" Height="28" Margin="0,8,0,0" Click="BtnAddScheduleCurrent_Click"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem x:Name="TabHistoryHeader" Header="🕒 Historia">
                <Border Background="#CC121216" CornerRadius="0,6,6,6" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="ListHistory" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Background="#191920" CornerRadius="6" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding}" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="BtnSearchYT" Grid.Row="1" Content="Wyszukaj zaznaczony utwór na YouTube" Height="28" Margin="0,6,0,0" Click="BtnSearchYouTube_Click"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem x:Name="TabTimerHeader" Header="⏱ Timer">
                <Border Background="#CC121216" CornerRadius="0,6,6,6" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="LblTimerTitle" Text="Wyłącznik Czasowy (Sleep Timer)" FontWeight="Bold" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="15 min" Padding="12,6" Margin="0,0,6,6" Click="Timer15_Click"/>
                            <Button Content="30 min" Padding="12,6" Margin="0,0,6,6" Click="Timer30_Click"/>
                            <Button Content="45 min" Padding="12,6" Margin="0,0,6,6" Click="Timer45_Click"/>
                            <Button Content="60 min" Padding="12,6" Margin="0,0,6,6" Click="Timer60_Click"/>
                        </WrapPanel>
                        <CheckBox x:Name="ChkShutdownPc" Content="Wyłącz komputer po upływie czasu" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,12"/>
                        <Button x:Name="BtnCancelTimer" Content="Anuluj aktywny timer" Height="28" Background="#26262F" Foreground="#EF4444" Click="BtnCancelTimer_Click"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="TabOptionsHeader" Header="⚙ Opcje">
                <Border Background="#CC121216" CornerRadius="0,6,6,6" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="LblSpotifyHeader" Text="Integracja ze Spotify (API)" FontWeight="Bold" Foreground="#1DB954" Margin="0,0,0,8"/>
                        <TextBlock x:Name="LblSpotifyDesc" Text="Client ID aplikacji Spotify:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,10">
                            <TextBox x:Name="TxtSpotifyClientId" Margin="0,0,6,0"/>
                            <Button x:Name="BtnSpotifyAuth" Content="Autoryzuj" Width="80" Height="28" Background="#1DB954" Foreground="#09090B" FontWeight="Bold" Click="BtnSpotifyLogin_Click"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtSpotifyStatus" Text="" FontSize="11" Foreground="#10B981" Margin="0,0,0,10"/>
                        
                        <Separator Background="#222228" Margin="0,0,0,10"/>
                        <TextBlock x:Name="LblLangSelect" Text="Język interfejsu / Language / Sprache:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ComboLangOptions" Width="140" HorizontalAlignment="Left" Height="28" Margin="0,0,0,10" SelectionChanged="ComboLang_SelectionChanged" Background="#1E1E24" Foreground="White">
                            <ComboBoxItem Content="🇵🇱 Polski (PL)"/>
                            <ComboBoxItem Content="🇬🇧 English (EN)"/>
                            <ComboBoxItem Content="🇱🇹 Lietuvių (LT)"/>
                            <ComboBoxItem Content="🇩🇪 Deutsch (DE)"/>
                        </ComboBox>

                        <CheckBox x:Name="ChkCoverArt" Content="Okładki albumów na żywo (iTunes)" Foreground="#FAFAFA" FontSize="11" Margin="0,0,0,6" Checked="ChkCoverArt_Changed" Unchecked="ChkCoverArt_Changed" IsChecked="True"/>
                        
                        <DockPanel Margin="0,4,0,0">
                            <Button x:Name="BtnOpenRecs" Content="📂 Nagrania (MP3)" Height="28" Width="130" Click="BtnOpenRecordsFolder_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Background="#CC141418" CornerRadius="6" Padding="8,5" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtDiagCodec" Text="MP3" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtDiagBitrate" Text="128 kbps" FontSize="10" Foreground="#A1A1AA" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtRecordingIndicator" Text="" FontSize="10" Foreground="#EF4444" FontWeight="Bold" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Text="RADYJKO 3.3.0 • OGŚ" FontSize="10" Foreground="#52525B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
